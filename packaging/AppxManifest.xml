<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap desktop rescap">
  <Identity Name="MTQQToaster" Publisher="CN=MTQQToaster Development" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>MTQQToaster</DisplayName>
    <PublisherDisplayName>MTQQToaster</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Resources><Resource Language="ja-jp" /><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Applications>
    <Application Id="App" Executable="MTQQToaster.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="MTQQToaster" Description="MQTT desktop notifications"
          Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png"
          BackgroundColor="transparent" />
      <Extensions>
        <desktop:Extension Category="windows.startupTask" Executable="MTQQToaster.exe" EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask TaskId="MTQQToasterStartup" Enabled="false" DisplayName="MTQQToaster" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
</Package>
