#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

// アイコン（トレイ用）
IDI_TRAYICON ICON "tray.ico"

// 必要なら複数サイズ入りの .ico を1つ用意する
// 16x16 / 32x32 が入っていると綺麗

// String table for Japanese
LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
IDR_TRAYMENU MENU
BEGIN
	POPUP ""
	BEGIN
		MENUITEM "設定...", ID_SETTINGS
		MENUITEM "スタートアップに登録", ID_STARTUP
		MENUITEM SEPARATOR
		MENUITEM "終了", ID_EXIT
	END
END

// String table for English
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
IDS_APP_NAME "MQTT Toast"
END

IDR_TRAYMENU MENU
BEGIN
	POPUP ""
	BEGIN
		MENUITEM "Settings...", ID_SETTINGS
		MENUITEM "Add to Startup", ID_STARTUP
		MENUITEM SEPARATOR
		MENUITEM "Exit", ID_EXIT
	END
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
IDD_SETTINGS DIALOGEX 0, 0, 290, 230
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "MTQQToaster 設定"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT           "MQTT URL", -1, 10, 12, 55, 10
    EDITTEXT        IDC_MQTT_URL, 70, 10, 188, 14, ES_AUTOHSCROLL
    LTEXT           "購読topic", -1, 10, 34, 55, 10
    LISTBOX         IDC_TOPIC_LIST, 70, 32, 208, 52, LBS_NOTIFY | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "追加", IDC_TOPIC_ADD, 70, 87, 42, 15
    PUSHBUTTON      "編集", IDC_TOPIC_EDIT, 116, 87, 42, 15
    PUSHBUTTON      "削除", IDC_TOPIC_DELETE, 162, 87, 42, 15
    LTEXT           "ユーザー名", -1, 10, 111, 55, 10
    EDITTEXT        IDC_MQTT_USER, 70, 109, 208, 14, ES_AUTOHSCROLL
    LTEXT           "パスワード", -1, 10, 132, 55, 10
    EDITTEXT        IDC_MQTT_PASS, 70, 130, 208, 14, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "ログレベル", -1, 10, 153, 55, 10
    COMBOBOX        IDC_LOG_LEVEL, 70, 151, 72, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "最大サイズ (MB)", -1, 10, 175, 58, 10
    EDITTEXT        IDC_LOG_SIZE, 70, 173, 45, 14, ES_NUMBER | ES_AUTOHSCROLL
    LTEXT           "保持数", -1, 135, 175, 35, 10
    EDITTEXT        IDC_LOG_FILES, 173, 173, 45, 14, ES_NUMBER | ES_AUTOHSCROLL
    DEFPUSHBUTTON   "保存", IDOK, 171, 204, 50, 16
    PUSHBUTTON      "キャンセル", IDCANCEL, 227, 204, 51, 16
END

IDD_TOPIC DIALOGEX 0, 0, 300, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "購読topic"
FONT 9, "Yu Gothic UI"
BEGIN
    LTEXT           "topic", -1, 10, 14, 42, 10
    EDITTEXT        IDC_TOPIC_NAME, 55, 12, 233, 14, ES_AUTOHSCROLL
    LTEXT           "既定画像", -1, 10, 40, 42, 10
    CONTROL         "", IDC_TOPIC_IMAGE, "STATIC", SS_BITMAP | SS_CENTERIMAGE | WS_BORDER, 55, 38, 120, 75
    LTEXT           "画像なし", IDC_IMAGE_STATUS, 183, 43, 105, 12
    PUSHBUTTON      "参照...", IDC_IMAGE_BROWSE, 183, 62, 54, 16
    PUSHBUTTON      "画像なし", IDC_IMAGE_CLEAR, 183, 82, 54, 16
    DEFPUSHBUTTON   "OK", IDOK, 182, 124, 50, 16
    PUSHBUTTON      "キャンセル", IDCANCEL, 238, 124, 50, 16
END

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION    1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		// English (United States)
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "MQTT Toast Notifier"
			VALUE "ProductName", "MQTT Toast"
			VALUE "FileVersion", "1.0.0"
		END
	END
END
