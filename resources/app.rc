#pragma code_page(65001)

#include <windows.h>
#include "resource.h"

IDI_TRAYICON ICON "tray.ico"

// OS-provided common controls; no Windows App SDK runtime is needed.
1 RT_MANIFEST "app.manifest"

IDD_SETTINGS DIALOGEX 0, 0, 370, 308
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
CAPTION "MTQQToaster 設定"
FONT 9, "Segoe UI"
BEGIN
    DEFPUSHBUTTON "保存(&S)", IDOK, 292, 284, 68, 16
    PUSHBUTTON "キャンセル", IDCANCEL, 216, 284, 68, 16
END

IDD_SETTINGS_FORM DIALOGEX 0, 0, 350, 258
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_VISIBLE | WS_VSCROLL | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI"
BEGIN
    LTEXT "MQTT URL(&U)", -1, 0, 1, 70, 12
    EDITTEXT IDC_MQTT_URL, 76, 0, 260, 16, ES_AUTOHSCROLL
    LTEXT "ユーザー名(&N)", -1, 0, 23, 70, 12
    EDITTEXT IDC_MQTT_USER, 76, 22, 260, 16, ES_AUTOHSCROLL
    LTEXT "パスワード(&P)", -1, 0, 45, 70, 12
    EDITTEXT IDC_MQTT_PASS, 76, 44, 260, 16, ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT "購読topic(&T)", -1, 0, 68, 180, 12
    LISTBOX IDC_TOPIC_LIST, 0, 82, 336, 70, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    LTEXT "topic(&O)", -1, 0, 159, 70, 12
    EDITTEXT IDC_TOPIC_NAME, 76, 158, 260, 16, ES_AUTOHSCROLL
    LTEXT "既定画像(&I)", -1, 0, 181, 70, 12
    EDITTEXT IDC_TOPIC_IMAGE, 76, 180, 182, 16, ES_AUTOHSCROLL
    PUSHBUTTON "参照...(&B)", IDC_IMAGE_BROWSE, 266, 180, 70, 16
    PUSHBUTTON "追加 / 更新(&A)", IDC_TOPIC_EDIT, 0, 204, 88, 16
    PUSHBUTTON "新規(&W)", IDC_TOPIC_ADD, 96, 204, 70, 16
    PUSHBUTTON "削除(&D)", IDC_TOPIC_DELETE, 174, 204, 70, 16
    LTEXT "ログレベル(&L)", -1, 0, 228, 100, 12
    LTEXT "最大サイズ MB(&M)", IDC_LOG_SIZE_LABEL, 116, 228, 100, 12
    LTEXT "保持数(&F)", IDC_LOG_FILES_LABEL, 232, 228, 100, 12
    COMBOBOX IDC_LOG_LEVEL, 0, 242, 104, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    EDITTEXT IDC_LOG_SIZE, 116, 242, 104, 16, ES_NUMBER | ES_AUTOHSCROLL
    EDITTEXT IDC_LOG_FILES, 232, 242, 104, 16, ES_NUMBER | ES_AUTOHSCROLL
END

LANGUAGE LANG_JAPANESE, SUBLANG_DEFAULT
IDR_TRAYMENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "設定...", ID_SETTINGS
        MENUITEM "スタートアップに登録", ID_STARTUP
        MENUITEM SEPARATOR
        MENUITEM "終了", ID_EXIT
    END
END

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
STRINGTABLE
BEGIN
IDS_APP_NAME "MQTT Toast"
END

IDR_TRAYMENU MENU
BEGIN
    POPUP ""
    BEGIN
        MENUITEM "Settings...", ID_SETTINGS
        MENUITEM "Add to Startup", ID_STARTUP
        MENUITEM SEPARATOR
        MENUITEM "Exit", ID_EXIT
    END
END

VS_VERSION_INFO VERSIONINFO
FILEVERSION    1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904b0"
		BEGIN
			VALUE "FileDescription", "MQTT Toast Notifier"
			VALUE "ProductName", "MQTT Toast"
			VALUE "FileVersion", "1.0.0"
		END
	END
END
